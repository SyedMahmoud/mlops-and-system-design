# Create .gitignore file
cat > .gitignore << EOF
# MLflow files
mlruns/
mlflow.db
mlflow-artifacts/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Large data files (optional - only if you don't want to upload CSV files)
# *.csv

# OS files
.DS_Store
Thumbs.db

# Models (these can be large and recreated)
models/
EOF